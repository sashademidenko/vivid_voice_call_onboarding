# Copy this file to .env and fill in real values. Never commit .env.

# --- AI model (used for the agent's replies and voice) ---
OPENAI_API_KEY=

# --- Twilio (needed only when provider = twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in international format, e.g. +15550001234
TWILIO_FROM_NUMBER=

# --- ngrok tunnel (needed only for Twilio: gives Twilio a public URL to reach your Mac) ---
NGROK_AUTHTOKEN=

# --- Call results table (optional): model that fills in data/calls.csv ---
# CALL_LOG_MODEL=gpt-5.6-luna
