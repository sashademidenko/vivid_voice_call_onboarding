// Voice Call plugin settings for local testing — no real phone calls.
// Apply with:  ./scripts/apply-config.sh   (mock is the default; then restart the Gateway)
{
  plugins: {
    entries: {
      "voice-call": {
        enabled: true,
        config: {
          // "mock" = pretend phone line, nothing leaves your computer.
          provider: "mock",

          // Fake numbers: mock never dials them.
          fromNumber: "+15550000001",
          toNumber: "+15550000002",

          // No public tunnel needed in mock mode (null = remove it if Twilio mode set one).
          tunnel: null,

          // Every call starts with a clean memory (no carry-over between calls).
          // Resuming cut-off calls is postponed until we see how often calls drop (outcome=cut_off in data/calls.csv).
          sessionScope: "per-call",

          // "conversation" = two-way dialogue, not a one-off announcement.
          outbound: {
            defaultMode: "conversation",
          },

          // Which OpenClaw agent answers on calls (see config/agent-noah.json5).
          agentId: "noah",

          // AI model for Noah's replies on calls. Without this, OpenClaw's global default (gpt-6-astra) is used.
          // Keep the same value in voice-call.mock.json5 and voice-call.twilio.json5.
          responseModel: "openai/gpt-5.6-terra",

          // Noah's instructions (responseSystemPrompt) are loaded from prompts/noah.md
          // by scripts/apply-config.sh, so the prompt lives in one readable file.
        },
      },
    },
  },
}
